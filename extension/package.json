{
  "name": "csformatter",
  "displayName": "CSFormatter",
  "description": "CodeMaid-style C# formatting: whitespace cleanup, comment reflow, member spacing, using sort, single-line initializers and constructor parameter lists.",
  "version": "0.2.1",
  "publisher": "csformatter",
  "license": "LGPL-3.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Formatters"
  ],
  "activationEvents": [
    "onCommand:csformatter.format"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "csformatter.format",
        "title": "Format with CSFormatter"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "csformatter.format",
          "when": "editorLangId == csharp && !editorReadonly",
          "group": "1_modification@100"
        }
      ]
    },
    "configuration": {
      "title": "CSFormatter",
      "properties": {
        "csformatter.formatComments": {
          "type": "boolean",
          "default": true,
          "description": "Reflow /// comment blocks and XML doc comments."
        },
        "csformatter.commentWrapColumn": {
          "type": "number",
          "default": 100,
          "description": "Column at which comment lines wrap."
        },
        "csformatter.sortUsings": {
          "type": "boolean",
          "default": true,
          "description": "Sort using directives: System first, then alphabetically."
        },
        "csformatter.padMembers": {
          "type": "boolean",
          "default": true,
          "description": "Insert a blank line before classes, methods, properties and other members."
        }
      }
    }
  },
  "scripts": {
    "build": "npm run compile && npm run build:cli",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build:cli": "dotnet publish ../src/CSFormatter.Cli -c Release -r win-x64 --self-contained -p:PublishSingleFile=true -o bin",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  }
}
